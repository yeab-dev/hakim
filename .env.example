# Every environment variable Hakim reads. Copy to .env.local (git ignores
# *.local files) for your own machine; on a host, set them in its settings.
# Nothing here is a secret, and nothing is NEXT_PUBLIC_: only the server reads
# these.

# The site's public origin, with no trailing slash. Used for metadataBase (so
# og:image and canonical URLs are absolute), sitemap.xml and robots.txt. It
# is read at build time for the static pages, so rebuild after changing it.
# Until the site is deployed, the default is the placeholder
# https://hakim.example.
SITE_URL=https://hakim.example

# Sessions are stored server-side (.data/sessions.json), so there is no
# signing secret to set.
